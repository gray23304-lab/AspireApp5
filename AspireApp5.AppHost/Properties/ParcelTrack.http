using System;
using System.Collections.Generic;
using System.Text;
@host = http://localhost:5000
@staff_token = PASTE_STAFF_TOKEN_HERE
@admin_token = PASTE_ADMIN_TOKEN_HERE

### 1. GET /api/parcels -> expect 200, with fees
GET {{host}}/api/parcels
Accept: application/json

### 2. POST /api/parcels with no token -> expect 401
POST {{host}}/api/parcels
Content-Type: application/json
X-Client: Branch desk

{
  "trackingCode": "PT-200201",
  "recipientName": "Damion Clarke",
  "weightKg": 4.2,
  "status": "Received",
  "branchId": 5
}

### 3. POST /api/auth/login as staff@parceltrack.test -> expect 200 + token
# @name staffLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "staff@parceltrack.test",
  "password": "Pass123!"
}

### 4. POST /api/auth/login as staff@parceltrack.test with wrong password -> expect 401
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "staff@parceltrack.test",
  "password": "WrongPassword!"
}

### 5. Request 2 again with Staff token -> expect 201 + Location header
POST {{host}}/api/parcels
Content-Type: application/json
Authorization: Bearer {{staff_token}}
X-Client: Branch desk

{
  "trackingCode": "PT-200201",
  "recipientName": "Damion Clarke",
  "weightKg": 4.2,
  "status": "Received",
  "branchId": 5
}

### 6. POST with Staff token and invalid tracking code AB-12 -> expect 400 with "Tracking code must look like PT-123456"
POST {{host}}/api/parcels
Content-Type: application/json
Authorization: Bearer {{staff_token}}
X-Client: Branch desk

{
  "trackingCode": "AB-12",
  "recipientName": "Test Recipient",
  "weightKg": 1.5,
  "status": "Received",
  "branchId": 1
}

### 7. POST with Staff token and no X-Client header -> expect 400 with "Say which program is calling: add an X-Client header"
POST {{host}}/api/parcels
Content-Type: application/json
Authorization: Bearer {{staff_token}}

{
  "trackingCode": "PT-200202",
  "recipientName": "Nadine Walker",
  "weightKg": 1.0,
  "status": "Received",
  "branchId": 1
}

### 8. DELETE /api/parcels/5 with Staff token -> expect 403
DELETE {{host}}/api/parcels/5
Authorization: Bearer {{staff_token}}
X-Client: Branch desk

### 9. POST /api/auth/login as admin@parceltrack.test -> expect 200 + token
# @name adminLogin
POST {{host}}/api/auth/login
Content-Type: application/json

{
  "email": "admin@parceltrack.test",
  "password": "Pass123!"
}

### 10. DELETE /api/parcels/5 with Admin token -> expect 204
DELETE {{host}}/api/parcels/5
Authorization: Bearer {{admin_token}}
X-Client: Branch desk
    {
    }
}
